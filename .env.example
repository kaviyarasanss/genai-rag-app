# Copy this file to .env and fill in your values. .env is ignored by Git: never commit it.

# LLM: any OpenAI-compatible chat API. Without a key, /ask returns the most relevant passages.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
# Gemini:  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  LLM_MODEL=<a Gemini model name>
# OpenAI:  LLM_BASE_URL=https://api.openai.com/v1  LLM_MODEL=<an OpenAI model name>
# Model names change over time: check your provider's current list.

LOG_LEVEL=INFO

# Port Nginx listens on, on your machine (default 80).
HTTP_PORT=80
